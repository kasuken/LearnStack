@page "/Account/ConfirmEmailChange"
@layout LearnStack.Components.Account.Shared.AccountLayout

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using LearnStack.Billing
@using LearnStack.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IBillingProvider BillingProvider
@inject ILogger<ConfirmEmailChange> Logger

<PageTitle>@L["Confirm email change"]</PageTitle>

<h1>@L["Confirm email change"]</h1>

<StatusMessage Message="@message"/>

@code {
    private string? message;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery] private string? UserId { get; set; }

    [SupplyParameterFromQuery] private string? Email { get; set; }

    [SupplyParameterFromQuery] private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Email is null || Code is null)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login", L["Error: Invalid email change confirmation link."], HttpContext);
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            message = L["Unable to find user with Id '{0}'", UserId!];
            return;
        }

        var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        var result = await UserManager.ChangeEmailAsync(user, Email, code);
        if (!result.Succeeded)
        {
            message = L["Error changing email."];
            return;
        }

        // In our UI email and user name are one and the same, so when we update the email
        // we need to update the user name.
        var setUserNameResult = await UserManager.SetUserNameAsync(user, Email);
        if (!setUserNameResult.Succeeded)
        {
            message = L["Error changing user name."];
            return;
        }

        // Best effort: the email change itself has already succeeded, and a failure here only
        // means receipts keep going to the old address until the next successful sync.
        if (!await BillingProvider.UpdateCustomerEmailAsync(user.Id, Email))
        {
            Logger.LogWarning("Billing customer email was not updated after user {UserId} changed their email.", user.Id);
        }

        await SignInManager.RefreshSignInAsync(user);
        message = L["Thank you for confirming your email change."];
    }

}