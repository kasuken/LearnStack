@page "/Account/Manage/Plan"

@using LearnStack.Billing
@using LearnStack.Data
@using LearnStack.Data.Models
@using LearnStack.Services
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IEntitlementService EntitlementService
@inject IBillingProvider BillingProvider
@inject IBillingWebhookProcessor BillingWebhookProcessor
@inject NavigationManager Navigation
@inject ILogger<Plan> Logger

<PageTitle>@L["Plan"]</PageTitle>

<div class="manage-section-header">
    <h3>@L["Plan & usage"]</h3>
    <p>@L["See your current LearnStack plan and resource usage, and upgrade or manage billing."]</p>
</div>

@if (_user is null)
{
    <p>@L["Loading..."]</p>
}
else if (_usage is not null)
{
    @if (_checkoutNotice is not null)
    {
        <div class="alert alert-success" role="status">@_checkoutNotice</div>
    }

    <div class="manage-card">
        <div class="form-group">
            <span class="form-label">@L["Current plan"]</span>
            <div><strong>@_usage.PlanDisplayName</strong> &mdash; @L[_usage.PlanPriceDescription]</div>
        </div>

        <div class="form-group">
            <span class="form-label">@L["Resources used"]</span>
            <div>
                <strong>
                    @(_usage.MaxResources.HasValue
                        ? $"{_usage.ResourceCount} / {_usage.MaxResources.Value}"
                        : L["{0} (unlimited)", _usage.ResourceCount].Value)
                </strong>
            </div>
        </div>

        @if (_usage.ResourceLimitReached)
        {
            <div class="alert-warning" role="alert">
                @L["You've reached your {0} plan's limit of {1} resources. Archive one or upgrade to add more.", _usage.PlanDisplayName, _usage.MaxResources!.Value]
            </div>
        }

        @if (_usage.PaidAccessSuspended)
        {
            <div class="alert-warning" role="alert">
                @L["Your Pro access is paused because a payment did not go through. Update your payment method under Manage billing to restore it."]
            </div>
        }
        else if (_usage.GracePeriodEndsAtUtc.HasValue)
        {
            <div class="alert-warning" role="alert">
                @L["A recent payment did not go through. Your Pro access continues until {0} (UTC); after that your plan reverts to Starter.", _usage.GracePeriodEndsAtUtc.Value.ToString("MMM d, yyyy")]
            </div>
        }

        @if (_usage.PlanCancelsAtUtc.HasValue)
        {
            <p class="form-hint">@L["Your Pro plan is cancelled and ends on {0} (UTC). You can resume it under Manage billing before then.", _usage.PlanCancelsAtUtc.Value.ToString("MMM d, yyyy")]</p>
        }
        else if (_usage.PlanRenewsAtUtc.HasValue)
        {
            <p class="form-hint">@L["Renews {0} (UTC).", _usage.PlanRenewsAtUtc.Value.ToString("MMM d, yyyy")]</p>
        }

        @if (_actionError is not null)
        {
            <div class="alert-error" role="alert">@_actionError</div>
        }

        @* Account pages render as static SSR, where @onclick never runs, so both actions are posted forms.
           A suspended subscription still exists at the provider and is fixed in the portal; a second
           checkout would start a duplicate subscription. *@
        @if (_usage.Tier == PlanTier.Starter && !_usage.PaidAccessSuspended)
        {
            <form method="post" @formname="upgrade" @onsubmit="UpgradeToProAsync" class="btn-group">
                <AntiforgeryToken />
                <button type="submit" name="Interval" value="@BillingInterval.Yearly" class="btn-primary">
                    @L["Upgrade to Pro (yearly)"]
                </button>
                <button type="submit" name="Interval" value="@BillingInterval.Monthly" class="btn-secondary">
                    @L["Upgrade to Pro (monthly)"]
                </button>
            </form>
        }
        else
        {
            <form method="post" @formname="billing-portal" @onsubmit="OpenBillingPortalAsync" class="btn-group">
                <AntiforgeryToken />
                <button type="submit" class="btn-secondary">@L["Manage billing"]</button>
            </form>
        }
    </div>

    <div class="manage-card" style="margin-top: 20px;">
        <div class="manage-section-header" style="margin-bottom: 12px;">
            <h3 style="font-size: 1.1rem;">@L["Plans"]</h3>
        </div>
        <ul>
            @foreach (var plan in PlanCatalog.All)
            {
                <li style="margin-bottom: 8px;">
                    <strong>@plan.DisplayName</strong> (@L[plan.PriceDescription]) &mdash; @string.Join(", ", plan.Capabilities.Select(c => L[c].Value))
                </li>
            }
        </ul>
    </div>
}

@code {
    private ApplicationUser? _user;
    private PlanUsageSummaryDto? _usage;
    private string? _actionError;
    private string? _checkoutNotice;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "upgrade")] private string? Interval { get; set; }

    [SupplyParameterFromQuery(Name = StripeBillingProvider.CheckoutSessionIdQueryKey)] private string? CheckoutSessionId { get; set; }

    [SupplyParameterFromQuery(Name = StripeBillingProvider.CheckoutOutcomeQueryKey)] private string? CheckoutOutcome { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _user = await UserManager.GetUserAsync(HttpContext.User);
        if (_user is null)
            return;

        if (HttpMethods.IsGet(HttpContext.Request.Method))
            await ShowCheckoutOutcomeAsync(_user.Id);

        _usage = await EntitlementService.GetUsageSummaryAsync(_user.Id);
    }

    private async Task ShowCheckoutOutcomeAsync(string userId)
    {
        if (CheckoutOutcome == StripeBillingProvider.CheckoutCancelledValue)
        {
            _checkoutNotice = L["Checkout was cancelled. You have not been charged."];
            return;
        }

        if (string.IsNullOrWhiteSpace(CheckoutSessionId))
            return;

        // Confirmed against the provider directly, because the webhook that would otherwise
        // upgrade the plan usually lands a few seconds after the user is already back here.
        var confirmed = false;
        try
        {
            confirmed = await BillingWebhookProcessor.ConfirmCheckoutAsync(userId, CheckoutSessionId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not confirm checkout session {SessionId} for user {UserId}.", CheckoutSessionId, userId);
        }

        _checkoutNotice = confirmed
            ? L["Welcome to Pro! Your plan is active."]
            : L["Payment received. Your Pro plan is being activated; refresh this page in a moment."];
    }

    private async Task UpgradeToProAsync()
    {
        if (_user is null)
            return;

        var interval = Enum.TryParse<BillingInterval>(Interval, ignoreCase: true, out var parsed) ? parsed : BillingInterval.Yearly;

        CheckoutSessionResult result;
        try
        {
            // The account email is passed so the billing customer is created under the address
            // the user signed in with, rather than one the hosted checkout page fills in itself.
            result = await BillingProvider.CreateCheckoutSessionAsync(
                _user.Id, PlanTier.Pro, interval, await UserManager.GetEmailAsync(_user));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Starting checkout failed for user {UserId}.", _user.Id);
            _actionError = L["LearnStack could not start checkout. Try again."];
            return;
        }

        if (!result.Supported)
        {
            _actionError = result.UnsupportedReason is null ? L["Checkout is not available right now."] : L[result.UnsupportedReason];
            return;
        }

        Navigation.NavigateTo(result.RedirectUrl!, forceLoad: true);
    }

    private async Task OpenBillingPortalAsync()
    {
        if (_user is null)
            return;

        PortalSessionResult result;
        try
        {
            result = await BillingProvider.CreatePortalSessionAsync(_user.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Opening the billing portal failed for user {UserId}.", _user.Id);
            _actionError = L["LearnStack could not open the billing portal. Try again."];
            return;
        }

        if (!result.Supported)
        {
            _actionError = result.UnsupportedReason is null ? L["The billing portal is not available right now."] : L[result.UnsupportedReason];
            return;
        }

        Navigation.NavigateTo(result.RedirectUrl!, forceLoad: true);
    }
}
