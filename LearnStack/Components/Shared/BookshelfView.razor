@using LearnStack.Common
@using LearnStack.Core.Helpers
@using LearnStack.Data
@using LearnStack.Helpers
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="bookshelf-wrapper" @onkeydown="HandleKeyDown" tabindex="0">
    @* Bookshelf Toolbar *@
    <div class="bookshelf-toolbar">
        <div class="bookshelf-toolbar-left">
            @* View Mode Selector: Spines on Shelf vs Covers Showcase *@
            <div class="view-mode-toggle">
                <button type="button" 
                        class="view-mode-btn @(displayMode == DisplayMode.Spines ? "active" : "")" 
                        @onclick="@(() => displayMode = DisplayMode.Spines)">
                    <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" />
                    <span>@L["BookshelfSpines"]</span>
                </button>
                <button type="button" 
                        class="view-mode-btn @(displayMode == DisplayMode.Covers ? "active" : "")" 
                        @onclick="@(() => displayMode = DisplayMode.Covers)">
                    <MudIcon Icon="@Icons.Material.Filled.ViewAgenda" Size="Size.Small" />
                    <span>@L["BookshelfCovers"]</span>
                </button>
            </div>

            @* Arrange By *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); font-weight: 600;">@L["ArrangeBy"]:</MudText>
                <MudSelect @bind-Value="arrangeBy" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" T="string" Style="width: 140px; font-size: 0.85rem;">
                    <MudSelectItem Value="@("topic")">@L["ContentType"]</MudSelectItem>
                    <MudSelectItem Value="@("status")">@L["Status"]</MudSelectItem>
                    <MudSelectItem Value="@("priority")">@L["Priority"]</MudSelectItem>
                    <MudSelectItem Value="@("continuous")">@L["CustomOrder"]</MudSelectItem>
                </MudSelect>
            </MudStack>
        </div>

        <div class="bookshelf-toolbar-right">
            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); font-weight: 500;">
                @GetSummaryStatistics()
            </MudText>
        </div>
    </div>

    @* Category Filter Chips (Screenshot 1) *@
    @if (availableCategories.Count > 1)
    {
        <div class="bookshelf-chips">
            <button type="button" 
                    class="bookshelf-chip @(selectedCategory == null ? "active" : "")" 
                    @onclick="@(() => selectedCategory = null)">
                <span>@L["AllShelves"]</span>
                <span class="bookshelf-chip-count">@Resources.Count</span>
            </button>
            @foreach (var cat in availableCategories)
            {
                <button type="button" 
                        class="bookshelf-chip @(selectedCategory == cat.Key ? "active" : "")" 
                        @onclick="@(() => selectedCategory = (selectedCategory == cat.Key ? null : cat.Key))">
                    <MudIcon Icon="@cat.Icon" Size="Size.Small" Style="font-size: 1rem;" />
                    <span>@cat.Label</span>
                    <span class="bookshelf-chip-count">@cat.Count</span>
                </button>
            }
        </div>
    }

    @* Empty state *@
    @if (!VisibleResources.Any())
    {
        <MudPaper Elevation="0" Class="pa-8 my-4 text-center" Style="border: 2px dashed var(--mud-palette-lines-default); border-radius: 16px; background: var(--mud-palette-background);">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" Style="color: var(--mud-palette-text-disabled);" />
            <MudText Typo="Typo.h6" Class="mt-2" Style="color: var(--mud-palette-text-secondary);">@L["NoResourcesFound"]</MudText>
        </MudPaper>
    }
    else if (displayMode == DisplayMode.Spines)
    {
        @* Spines on Shelf View (Screenshot 1) *@
        <div class="shelves-container">
            @foreach (var shelf in Shelves)
            {
                <div class="shelf-section">
                    @if (!string.IsNullOrEmpty(shelf.Title))
                    {
                        <div class="shelf-header">
                            <div class="shelf-header-title">
                                @if (!string.IsNullOrEmpty(shelf.Icon))
                                {
                                    <MudIcon Icon="@shelf.Icon" Size="Size.Small" />
                                }
                                <span>@shelf.Title</span>
                            </div>
                        </div>
                    }

                    <div class="shelf-stage">
                        <div class="shelf-bookend left"></div>
                        <div class="shelf-bookend right"></div>

                        <div class="shelf-books-row">
                            @foreach (var resource in shelf.Books)
                            {
                                var r = resource;
                                var height = GetBookHeight(r);
                                var width = GetBookThickness(r);
                                var spineBg = GetSpineColor(r);
                                var hasRibbon = r.Status == ContentStatus.InProgress || r.Priority == Priority.High;
                                var ribbonColor = r.Status == ContentStatus.InProgress ? "emerald" : "gold";
                                var hasLabel = (r.Id % 4) == 0;
                                var isHovered = hoveredResourceId == r.Id;
                                var isSelected = selectedResource?.Id == r.Id;

                                <div class="book-spine @(isSelected ? "selected" : "")"
                                     style="height: @(height)px; width: @(width)px; background: @spineBg;"
                                     @onclick="@(() => TakeDownBook(r))"
                                     @onmouseenter="@(() => hoveredResourceId = r.Id)"
                                     @onmouseleave="@(() => { if (hoveredResourceId == r.Id) hoveredResourceId = null; })">
                                    
                                    @* Bookmark Ribbon *@
                                    @if (hasRibbon)
                                    {
                                        <div class="bookmark-ribbon @ribbonColor"></div>
                                    }

                                    @* Embossed Accent Ridges *@
                                    <div class="spine-ridge top-1"></div>
                                    <div class="spine-ridge top-2"></div>
                                    <div class="spine-ridge bottom-1"></div>
                                    <div class="spine-ridge bottom-2"></div>

                                    @* Paper Label Band if applicable *@
                                    @if (hasLabel)
                                    {
                                        <div class="spine-paper-label">
                                            <span class="spine-title">@r.Title</span>
                                        </div>
                                    }

                                    <div class="spine-content">
                                        @if (r.Status == ContentStatus.Completed)
                                        {
                                            <div class="spine-completed-star">★</div>
                                        }
                                        else
                                        {
                                            <div></div>
                                        }

                                        @if (!hasLabel)
                                        {
                                            <div class="spine-title-wrap">
                                                <span class="spine-title">@r.Title</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="spine-title-wrap"></div>
                                        }

                                        <div class="spine-tag">@GetDomainShort(r.Url)</div>
                                    </div>

                                    @* Hover Tooltip (Screenshot 1) *@
                                    @if (isHovered && selectedResource == null)
                                    {
                                        <div class="spine-tooltip">
                                            <span class="spine-tooltip-title">@r.Title</span>
                                            <span class="spine-tooltip-sub">
                                                <span>@GetDomainFromUrl(r.Url)</span>
                                                <span>•</span>
                                                <span>@GetContentTypeText(r.ContentType)</span>
                                                <span>•</span>
                                                <span>@GetStatusText(r.Status)</span>
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @* Shelf Board *@
                        <div class="shelf-board">
                            <div class="shelf-board-top"></div>
                            <div class="shelf-board-front"></div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(shelf.TagBadge))
                    {
                        <div class="shelf-footer-tag">
                            @if (!string.IsNullOrEmpty(shelf.Icon))
                            {
                                <MudIcon Icon="@shelf.Icon" Size="Size.Small" Style="font-size: 0.9rem;" />
                            }
                            <span>@shelf.TagBadge</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        @* Front Cover Showcase View (Screenshot 3) *@
        <div class="covers-showcase-grid">
            @foreach (var r in VisibleResources)
            {
                var coverBg = GetSpineColor(r);
                <div class="showcase-book-item" @onclick="@(() => TakeDownBook(r))">
                    <div class="showcase-book-card" style="background: @coverBg;">
                        <div class="showcase-book-inner">
                            <div class="showcase-art-box">
                                @if (r.ThumbnailImage != null && r.ThumbnailImage.Length > 0)
                                {
                                    <img src="@($"data:image/png;base64,{Convert.ToBase64String(r.ThumbnailImage)}")" alt="@r.Title" />
                                }
                                else if (!string.IsNullOrEmpty(r.ThumbnailUrl))
                                {
                                    <img src="@r.ThumbnailUrl" alt="@r.Title" />
                                }
                                else
                                {
                                    @GetCoverArtworkSvg(r.ContentType)
                                }
                            </div>
                            <div class="showcase-meta">
                                @GetContentTypeText(r.ContentType)
                            </div>
                            <div class="showcase-title">@r.Title</div>
                            <div class="showcase-author">@GetDomainFromUrl(r.Url)</div>
                        </div>
                    </div>
                    <div class="showcase-footer">
                        <span>@DateTimeHelper.GetRelativeDate(r.DateAdded, L, TimeZoneId)</span>
                        <MudChip T="string" Size="Size.Small" Class="@EnumDisplayHelper.GetChipClass(r.Status)" Style="font-size: 0.7rem; height: 20px;">
                            @GetStatusText(r.Status)
                        </MudChip>
                    </div>
                </div>
            }
        </div>
    }

    @* Take-Down Book Modal (Screenshot 2) *@
    @if (selectedResource != null)
    {
        <div class="book-modal-backdrop" @onclick="CloseBook">
            <div class="book-card-3d" style="background: @GetSpineColor(selectedResource);" @onclick:stopPropagation="true">
                <div class="book-card-spine-hinge"></div>
                <div class="book-card-inner">
                    @* Cover Art / Thumbnail Window *@
                    <div class="book-cover-art-box">
                        @if (selectedResource.ThumbnailImage != null && selectedResource.ThumbnailImage.Length > 0)
                        {
                            <img src="@($"data:image/png;base64,{Convert.ToBase64String(selectedResource.ThumbnailImage)}")" alt="@selectedResource.Title" />
                        }
                        else if (!string.IsNullOrEmpty(selectedResource.ThumbnailUrl))
                        {
                            <img src="@selectedResource.ThumbnailUrl" alt="@selectedResource.Title" />
                        }
                        else
                        {
                            @GetCoverArtworkSvg(selectedResource.ContentType)
                        }
                    </div>

                    @* Metadata Row *@
                    <div class="book-cover-meta">
                        <MudIcon Icon="@EnumDisplayHelper.GetIcon(selectedResource.ContentType)" Size="Size.Small" Style="font-size: 1rem;" />
                        <span>@GetContentTypeText(selectedResource.ContentType)</span>
                        <span>•</span>
                        <span>@selectedResource.DateAdded.Year</span>
                    </div>

                    @* Title *@
                    <div class="book-cover-title" title="@selectedResource.Title">
                        @selectedResource.Title
                    </div>

                    @* Author / Domain *@
                    <div class="book-cover-author">
                        @GetDomainFromUrl(selectedResource.Url)
                    </div>

                    @* Description *@
                    @if (!string.IsNullOrEmpty(selectedResource.Description))
                    {
                        <div class="book-cover-description">
                            @selectedResource.Description
                        </div>
                    }

                    @* Tags & Status Chips *@
                    <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                        <MudChip T="string" Size="Size.Small" Class="@EnumDisplayHelper.GetChipClass(selectedResource.Status)">
                            @GetStatusText(selectedResource.Status)
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Class="@EnumDisplayHelper.GetChipClass(selectedResource.Priority)">
                            @GetPriorityText(selectedResource.Priority)
                        </MudChip>
                        @if (!string.IsNullOrEmpty(selectedResource.Tags))
                        {
                            @foreach (var tag in selectedResource.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="border-color: rgba(255,255,255,0.4); color: white;">
                                    @tag.Trim()
                                </MudChip>
                            }
                        }
                    </MudStack>

                    @* Action Buttons *@
                    <div class="book-card-actions">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Filled.OpenInNew"
                                   Href="@selectedResource.Url" 
                                   Target="_blank"
                                   Style="border-radius: 8px; font-weight: 600; text-transform: none;">
                            @L["OpenResource"]
                        </MudButton>

                        <MudStack Row="true" Spacing="1">
                            @if (!ReadOnly)
                            {
                                @if (selectedResource.Status != ContentStatus.InProgress)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" 
                                                   Size="Size.Small" 
                                                   Style="color: #f59e0b; background: rgba(0,0,0,0.25);" 
                                                   aria-label="@L["InProgress"].Value" 
                                                   OnClick="@(() => OnStatusChanged.InvokeAsync((selectedResource, ContentStatus.InProgress)))" />
                                }
                                @if (selectedResource.Status != ContentStatus.Completed)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Check" 
                                                   Size="Size.Small" 
                                                   Style="color: #10b981; background: rgba(0,0,0,0.25);" 
                                                   aria-label="@L["Completed"].Value" 
                                                   OnClick="@(() => OnStatusChanged.InvokeAsync((selectedResource, ContentStatus.Completed)))" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                               Size="Size.Small" 
                                               Style="color: white; background: rgba(0,0,0,0.25);" 
                                               aria-label="@L["Edit"].Value" 
                                               OnClick="@(() => OnEdit.InvokeAsync(selectedResource))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Size="Size.Small" 
                                               Style="color: #ef4444; background: rgba(0,0,0,0.25);" 
                                               aria-label="@L["Delete"].Value" 
                                               OnClick="@(() => OnDelete.InvokeAsync(selectedResource.Id))" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Close" 
                                           Size="Size.Small" 
                                           Style="color: white; background: rgba(0,0,0,0.25);" 
                                           aria-label="@L["PutBackOnShelf"].Value" 
                                           OnClick="CloseBook" />
                        </MudStack>
                    </div>

                    @* Walking the shelf navigation instructions *@
                    <div class="walk-shelf-helper">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Style="color: white;" OnClick="NavigatePrevious" aria-label="@L["PreviousBook"].Value" />
                            <span>@L["ClickSpineToTakeDown"]</span>
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="color: white;" OnClick="NavigateNext" aria-label="@L["NextBook"].Value" />
                        </MudStack>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private enum DisplayMode
    {
        Spines,
        Covers
    }

    private class CategoryInfo
    {
        public string Key { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public int Count { get; set; }
    }

    private class ShelfGroup
    {
        public string Title { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public string TagBadge { get; set; } = string.Empty;
        public List<LearningResource> Books { get; set; } = [];
    }

    [Parameter]
    public IReadOnlyList<LearningResource> Resources { get; set; } = [];

    [Parameter]
    public string? TimeZoneId { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public EventCallback<LearningResource> OnEdit { get; set; }

    [Parameter]
    public EventCallback<int> OnDelete { get; set; }

    [Parameter]
    public EventCallback<(LearningResource Resource, ContentStatus Status)> OnStatusChanged { get; set; }

    [Parameter]
    public EventCallback<LearningResource> OnToggleArchive { get; set; }

    [Parameter]
    public EventCallback<LearningResource> OnTogglePublic { get; set; }

    private DisplayMode displayMode = DisplayMode.Spines;
    private string arrangeBy = "topic";
    private string? selectedCategory;
    private int? hoveredResourceId;
    private LearningResource? selectedResource;

    private List<CategoryInfo> availableCategories = [];
    private List<ShelfGroup> Shelves = [];

    protected override void OnParametersSet()
    {
        RebuildCategoriesAndShelves();
    }

    private IEnumerable<LearningResource> VisibleResources =>
        string.IsNullOrEmpty(selectedCategory)
            ? Resources
            : Resources.Where(r => MatchesCategory(r, selectedCategory));

    private bool MatchesCategory(LearningResource r, string catKey)
    {
        if (catKey.StartsWith("type:"))
        {
            var typeStr = catKey.Substring(5);
            return r.ContentType.ToString() == typeStr;
        }
        if (catKey.StartsWith("status:"))
        {
            var statusStr = catKey.Substring(7);
            return r.Status.ToString() == statusStr;
        }
        if (catKey.StartsWith("priority:"))
        {
            var pStr = catKey.Substring(9);
            return r.Priority.ToString() == pStr;
        }
        return true;
    }

    private void RebuildCategoriesAndShelves()
    {
        availableCategories.Clear();
        Shelves.Clear();

        if (!Resources.Any()) return;

        // Build categories based on arrangeBy
        if (arrangeBy == "topic")
        {
            foreach (ContentType type in Enum.GetValues<ContentType>())
            {
                var count = Resources.Count(r => r.ContentType == type);
                if (count > 0)
                {
                    availableCategories.Add(new CategoryInfo
                    {
                        Key = $"type:{type}",
                        Label = GetContentTypeText(type),
                        Icon = EnumDisplayHelper.GetIcon(type),
                        Count = count
                    });
                }
            }
        }
        else if (arrangeBy == "status")
        {
            foreach (ContentStatus status in Enum.GetValues<ContentStatus>())
            {
                var count = Resources.Count(r => r.Status == status);
                if (count > 0)
                {
                    availableCategories.Add(new CategoryInfo
                    {
                        Key = $"status:{status}",
                        Label = GetStatusText(status),
                        Icon = Icons.Material.Filled.Bookmark,
                        Count = count
                    });
                }
            }
        }
        else if (arrangeBy == "priority")
        {
            foreach (Priority priority in Enum.GetValues<Priority>())
            {
                var count = Resources.Count(r => r.Priority == priority);
                if (count > 0)
                {
                    availableCategories.Add(new CategoryInfo
                    {
                        Key = $"priority:{priority}",
                        Label = GetPriorityText(priority),
                        Icon = Icons.Material.Filled.Flag,
                        Count = count
                    });
                }
            }
        }

        // Build shelves
        var resourcesToPlace = VisibleResources.ToList();
        if (arrangeBy == "topic" && string.IsNullOrEmpty(selectedCategory))
        {
            var grouped = resourcesToPlace.GroupBy(r => r.ContentType).OrderBy(g => g.Key);
            foreach (var g in grouped)
            {
                Shelves.Add(new ShelfGroup
                {
                    Title = GetContentTypeText(g.Key),
                    Icon = EnumDisplayHelper.GetIcon(g.Key),
                    TagBadge = $"{GetContentTypeText(g.Key)} ({g.Count()})",
                    Books = g.ToList()
                });
            }
        }
        else if (arrangeBy == "status" && string.IsNullOrEmpty(selectedCategory))
        {
            var grouped = resourcesToPlace.GroupBy(r => r.Status).OrderBy(g => g.Key);
            foreach (var g in grouped)
            {
                Shelves.Add(new ShelfGroup
                {
                    Title = GetStatusText(g.Key),
                    Icon = Icons.Material.Filled.Bookmark,
                    TagBadge = $"{GetStatusText(g.Key)} ({g.Count()})",
                    Books = g.ToList()
                });
            }
        }
        else if (arrangeBy == "priority" && string.IsNullOrEmpty(selectedCategory))
        {
            var grouped = resourcesToPlace.GroupBy(r => r.Priority).OrderByDescending(g => g.Key);
            foreach (var g in grouped)
            {
                Shelves.Add(new ShelfGroup
                {
                    Title = GetPriorityText(g.Key),
                    Icon = Icons.Material.Filled.Flag,
                    TagBadge = $"{GetPriorityText(g.Key)} ({g.Count()})",
                    Books = g.ToList()
                });
            }
        }
        else
        {
            // Continuous or filtered: divide into shelves of up to 16 books per shelf
            const int booksPerShelf = 16;
            var chunks = resourcesToPlace.Chunk(booksPerShelf).ToList();
            for (int i = 0; i < chunks.Count; i++)
            {
                Shelves.Add(new ShelfGroup
                {
                    Title = chunks.Count > 1 ? $"{L["BookshelfView"].Value} #{i + 1}" : "",
                    Icon = Icons.Material.Filled.MenuBook,
                    TagBadge = $"{chunks[i].Length} {L["AllShelves"].Value.ToLower()}",
                    Books = chunks[i].ToList()
                });
            }
        }
    }

    private void TakeDownBook(LearningResource resource)
    {
        selectedResource = resource;
    }

    private void CloseBook()
    {
        selectedResource = null;
    }

    private void NavigatePrevious()
    {
        if (selectedResource == null) return;
        var list = VisibleResources.ToList();
        var idx = list.FindIndex(r => r.Id == selectedResource.Id);
        if (idx > 0)
        {
            selectedResource = list[idx - 1];
        }
        else if (list.Count > 0)
        {
            selectedResource = list[list.Count - 1];
        }
    }

    private void NavigateNext()
    {
        if (selectedResource == null) return;
        var list = VisibleResources.ToList();
        var idx = list.FindIndex(r => r.Id == selectedResource.Id);
        if (idx >= 0 && idx < list.Count - 1)
        {
            selectedResource = list[idx + 1];
        }
        else if (list.Count > 0)
        {
            selectedResource = list[0];
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (selectedResource == null) return;
        if (e.Key == "ArrowLeft")
        {
            NavigatePrevious();
        }
        else if (e.Key == "ArrowRight")
        {
            NavigateNext();
        }
        else if (e.Key == "Escape")
        {
            CloseBook();
        }
    }

    private int GetBookHeight(LearningResource r)
    {
        // 175px to 225px varied deterministically
        return 175 + (Math.Abs(r.Id * 17 + r.Title.Length * 7) % 50);
    }

    private int GetBookThickness(LearningResource r)
    {
        // 28px to 44px varied deterministically
        return 28 + (Math.Abs(r.Id * 31 + r.Title.Length * 3) % 17);
    }

    private string GetSpineColor(LearningResource r)
    {
        // Deterministic shade variant
        var variant = Math.Abs(r.Id * 13) % 4;
        return r.ContentType switch
        {
            ContentType.Article => variant switch
            {
                0 => "#1b4332",
                1 => "#2d6a4f",
                2 => "#22573f",
                _ => "#17382a"
            },
            ContentType.BlogPost => variant switch
            {
                0 => "#521b33",
                1 => "#662441",
                2 => "#5c1f3a",
                _ => "#47152a"
            },
            ContentType.Video => variant switch
            {
                0 => "#803816",
                1 => "#99431b",
                2 => "#8a3d18",
                _ => "#6e2f11"
            },
            ContentType.Course => variant switch
            {
                0 => "#132238",
                1 => "#1a2e4a",
                2 => "#17273f",
                _ => "#0f1c2e"
            },
            ContentType.Documentation => variant switch
            {
                0 => "#331f47",
                1 => "#42285a",
                2 => "#3a234f",
                _ => "#29183b"
            },
            ContentType.Podcast => variant switch
            {
                0 => "#12393d",
                1 => "#18484d",
                2 => "#154145",
                _ => "#0e2f33"
            },
            _ => "#2e2e38"
        };
    }

    private string GetDomainFromUrl(string url)
    {
        try
        {
            var uri = new Uri(url);
            return uri.Host.Replace("www.", "");
        }
        catch
        {
            return url;
        }
    }

    private string GetDomainShort(string url)
    {
        var domain = GetDomainFromUrl(url);
        var parts = domain.Split('.');
        return (parts.Length > 0 ? parts[0] : domain).ToUpperInvariant();
    }

    private string GetSummaryStatistics()
    {
        var count = Resources.Count;
        var inProgress = Resources.Count(r => r.Status == ContentStatus.InProgress);
        var completed = Resources.Count(r => r.Status == ContentStatus.Completed);
        return $"{count} items • {inProgress} in progress • {completed} completed";
    }

    private string GetContentTypeText(ContentType type) => type switch
    {
        ContentType.BlogPost => L["BlogPost"].Value,
        ContentType.Podcast => L["Podcast"].Value,
        ContentType.Video => L["Video"].Value,
        ContentType.Article => L["Article"].Value,
        ContentType.Course => L["Course"].Value,
        ContentType.Documentation => L["Documentation"].Value,
        _ => L["Other"].Value
    };

    private string GetStatusText(ContentStatus status) => status switch
    {
        ContentStatus.ToLearn => L["ToLearn"].Value,
        ContentStatus.InProgress => L["InProgress"].Value,
        ContentStatus.Completed => L["Completed"].Value,
        _ => L["Unknown"].Value
    };

    private string GetPriorityText(Priority priority) => priority switch
    {
        Priority.High => L["High"].Value,
        Priority.Medium => L["Medium"].Value,
        Priority.Low => L["Low"].Value,
        _ => L["Unknown"].Value
    };

    private RenderFragment GetCoverArtworkSvg(ContentType type) => builder =>
    {
        // Custom woodcut / engraving classical art tailored to each ContentType (matching Screenshots 2 & 3!)
        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "viewBox", "0 0 200 160");
        builder.AddAttribute(2, "class", "book-cover-art-svg");
        builder.AddAttribute(3, "style", "fill: none; stroke: #2a3a30; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;");

        switch (type)
        {
            case ContentType.Article:
                // Classical Tree of Knowledge & Archway (Screenshot 2 style)
                builder.AddContent(4, (MarkupString)@"
                    <path d='M30 145 H170 M40 145 V105 A60 60 0 0 1 160 105 V145' stroke-width='2'/>
                    <path d='M60 145 V110 A40 40 0 0 1 140 110 V145' stroke-dasharray='3 3'/>
                    <path d='M100 110 V65 M100 65 Q70 45 45 40 M100 65 Q130 45 155 40 M100 50 Q60 25 75 10 M100 50 Q140 25 125 10 M100 35 V15' stroke-width='2'/>
                    <circle cx='100' cy='15' r='4' fill='#2a3a30'/>
                    <circle cx='75' cy='10' r='3' fill='#2a3a30'/>
                    <circle cx='125' cy='10' r='3' fill='#2a3a30'/>
                    <circle cx='45' cy='40' r='3' fill='#2a3a30'/>
                    <circle cx='155' cy='40' r='3' fill='#2a3a30'/>
                    <circle cx='100' cy='65' r='55' stroke-dasharray='2 4' opacity='0.5'/>
                ");
                break;

            case ContentType.Video:
                // Celestial Observatory & Telescope (Screenshot 3 style)
                builder.AddContent(4, (MarkupString)@"
                    <path d='M30 145 H170 M60 145 V80 A40 40 0 0 1 140 80 V145' stroke-width='2'/>
                    <path d='M100 40 A40 40 0 0 0 60 80 H140 A40 40 0 0 0 100 40 Z' fill='#eef3ed'/>
                    <path d='M70 115 L145 35 M140 30 L155 45 M65 110 L75 120' stroke-width='3'/>
                    <ellipse cx='100' cy='35' rx='70' ry='18' stroke-dasharray='3 3' opacity='0.6'/>
                    <circle cx='160' cy='32' r='5' fill='#2a3a30'/>
                    <circle cx='40' cy='38' r='3' fill='#2a3a30'/>
                ");
                break;

            case ContentType.BlogPost:
                // Vintage Quill & Open Book
                builder.AddContent(4, (MarkupString)@"
                    <path d='M40 120 Q100 135 100 105 Q100 135 160 120 V75 Q100 90 100 60 Q100 90 40 75 Z' stroke-width='2' fill='#f4ede2'/>
                    <path d='M100 60 V105' stroke-width='2'/>
                    <path d='M50 85 Q75 92 90 85 M50 97 Q75 104 90 97 M110 85 Q125 92 150 85 M110 97 Q125 104 150 97'/>
                    <path d='M145 25 Q135 45 125 70 Q135 55 155 45 Z' fill='#2a3a30'/>
                    <path d='M125 70 L115 90' stroke-width='1.5'/>
                ");
                break;

            case ContentType.Course:
                // Blackboard with Geometry & Orbits (Screenshot 3 style)
                builder.AddContent(4, (MarkupString)@"
                    <rect x='35' y='30' width='130' height='90' rx='4' stroke-width='2'/>
                    <line x1='30' y1='125' x2='170' y2='125' stroke-width='3'/>
                    <ellipse cx='100' cy='75' rx='45' ry='20' stroke-dasharray='4 3'/>
                    <circle cx='100' cy='75' r='10' stroke-width='2'/>
                    <path d='M55 95 L100 45 L145 95 Z' opacity='0.7'/>
                    <circle cx='135' cy='62' r='4' fill='#2a3a30'/>
                ");
                break;

            case ContentType.Documentation:
                // Classical Library Portal & Columns
                builder.AddContent(4, (MarkupString)@"
                    <path d='M25 145 H175 M35 145 V65 M50 145 V65 M150 145 V65 M165 145 V65' stroke-width='2'/>
                    <path d='M30 65 H170 L100 25 Z' stroke-width='2' fill='#f4ede2'/>
                    <circle cx='100' cy='48' r='10' stroke-dasharray='2 2'/>
                    <path d='M70 145 V90 A30 30 0 0 1 130 90 V145' stroke-width='2'/>
                ");
                break;

            case ContentType.Podcast:
                // Acoustic Soundwaves & Gramophone
                builder.AddContent(4, (MarkupString)@"
                    <circle cx='100' cy='80' r='18' stroke-width='2'/>
                    <path d='M100 98 V130 M80 130 H120' stroke-width='2'/>
                    <path d='M70 65 A35 35 0 0 0 70 95 M60 55 A50 50 0 0 0 60 105' stroke-width='2'/>
                    <path d='M130 65 A35 35 0 0 1 130 95 M140 55 A50 50 0 0 1 140 105' stroke-width='2'/>
                ");
                break;

            default:
                builder.AddContent(4, (MarkupString)@"
                    <circle cx='100' cy='80' r='35' stroke-width='2'/>
                    <path d='M75 80 H125 M100 55 V105' stroke-width='2'/>
                ");
                break;
        }

        builder.CloseElement();
    };
}
